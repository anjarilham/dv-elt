# =============================================================================
# .env.example
#
# Copy this file to ".env" and replace the placeholder values with your real ones.
# NEVER commit the real .env file: it is already listed in .gitignore.
#
# Notes:
#   - Values are plain text. No quotes are needed.
#   - Keep comments on their own lines, not after a value.
#   - A line left empty (for example "SEARCH_DATE_RANGE_START=") counts as not set.
# =============================================================================


# -----------------------------------------------------------------------------
# Dataverse API                              (extractor.py, extractor_main.py)
# -----------------------------------------------------------------------------

# No Dataverse account or API token is needed: the pipeline only reads public
# data, which the Dataverse search API serves to anonymous requests.

# REQUIRED. Dataverse server root URL. Must start with http:// or https://.
# A trailing "/" is removed automatically.
BASE_URL=https://demo.dataverse.org

# Text sent as the search "q" parameter. "*" means every dataset. Default: *
SEARCH_QUERY=*

# REQUIRED. Comma-separated aliases of the dataverses to extract.
# Duplicates are removed. Example for the demo server: dvn, YY
ALL_DATAVERSE_LIST=your-dataverse-alias

# Optional date window, format YYYY-MM-DD.
# Set BOTH or leave BOTH empty (empty = extract all dates).
# The window runs from 00:00:00 UTC of the start date to 00:00:00 UTC of the end date.
SEARCH_DATE_RANGE_START=
SEARCH_DATE_RANGE_END=

# -----------------------------------------------------------------------------
# MinIO / S3 raw (bronze) storage                    (raw_store.py, extractor_main.py)
# -----------------------------------------------------------------------------

# REQUIRED. MinIO server URL including http:// or https://.
# This is the S3 API port (9000 by default), not the web console port (9001).
MINIO_ENDPOINT=http://localhost:9000

# REQUIRED. For local development MinIO's default is minioadmin / minioadmin.
# For anything shared, create a dedicated access key limited to the raw bucket.
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# Bucket for the raw (bronze) layer. Created automatically if it does not exist.
# Rules: 3-63 characters, lowercase letters, digits, "-" and "." only (no underscores).
MINIO_BUCKET=raw

# -----------------------------------------------------------------------------
# Logging                                                       (extractor_main.py)
# -----------------------------------------------------------------------------

# Base name of the log file, without the .log extension (it is stripped if present).
# Every run writes its own file: logs/<LOG_FILE>_<YYYY-MM-DD_HH-MM-SS>.log
# Default: pipeline
LOG_FILE=dataverse_etl
